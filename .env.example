# Copy this file to .env (repo root) and fill in real values locally.
# .env is git-ignored — never commit it, print it, or paste its contents
# anywhere.
#
# Both the Python pipeline and the Java API load this file automatically:
#   - Python: pipelines/ingest/config.py calls python-dotenv's
#     load_dotenv(), which searches upward from wherever it's invoked and
#     finds this file at the repo root regardless of your shell's cwd.
#   - Java: apps/api's ApiApplication.main() calls DotenvLoader (see
#     apps/api/src/main/java/dev/repair/api/config/DotenvLoader.java)
#     before Spring starts, which does the same upward search. A value
#     already set as a real exported environment variable always wins
#     over this file.
# Docker Compose does NOT read this file automatically — its own defaults
# are hardcoded in docker-compose.yml (they contain no real secret).

# ---- OpenAI (required only for live chat generation and knowledge-corpus
#      embedding; the catalogue and data-quality views work without it) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# ---- Database (matches docker-compose.yml defaults; only override if you
#      changed the compose file) ----
DB_HOST=localhost
DB_PORT=5544
DB_NAME=repair_v2
DB_USER=repair_v2
DB_PASSWORD=repair_v2_local_only

# ---- Java API ----
API_PORT=8082

# ---- Next.js web app -> Java API proxy target ----
API_ORIGIN=http://localhost:8082

# ---- Chat bounds (safe defaults; override only if you know why) ----
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_RETRIEVED_CHUNKS=6
CHAT_MAX_OUTPUT_TOKENS=900
CHAT_MAX_EVIDENCE_WORDS=1200
